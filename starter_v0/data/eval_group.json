{
  "dataset_id": "day04_v3_finance_group",
  "dataset_role": "group",
  "description": "Team-authored eval cases for Personal Finance Assistant Agent. Contains 10 original cases: 5 single-turn and 5 multi-turn scenarios testing expense tracking, budgeting, and financial queries.",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [
    {
      "id": "G01_summary_last_week", "phase": "B", "suite": "group",
      "query": "Tuần trước tôi chi tiêu tổng cộng bao nhiêu?",
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "get_summary", "args": {"period": "last_week"}}]},
      "metadata": {"skill": "route_last_week", "difficulty": "easy", "what_it_tests": "Tuần trước phải map sang last_week trong get_summary."}
    },
    {
      "id": "G02_record_expense_complete", "phase": "B", "suite": "group",
      "query": "Xác nhận ghi chi tiêu mua áo 650000 đồng hôm nay, ghi chú mua áo Uniqlo.",
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "record_transaction", "args": {"type": "expense", "category": "shopping", "amount": 650000, "note": "mua áo Uniqlo", "confirmed": true}}]},
      "metadata": {"skill": "route_record_complete", "difficulty": "medium", "what_it_tests": "Đủ thông tin và có 'xác nhận' phải gọi record_transaction với confirmed=true."}
    },
    {
      "id": "G03_category_breakdown_housing", "phase": "B", "suite": "group",
      "query": "Chi tiết chi tiêu nhà ở và tiện ích tháng này.",
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "get_category_breakdown", "args": {"period": "this_month", "category": "housing"}}]},
      "metadata": {"skill": "route_breakdown_housing", "difficulty": "easy", "what_it_tests": "Chi tiết category housing phải dùng get_category_breakdown."}
    },
    {
      "id": "G04_forecast_bonus", "phase": "B", "suite": "group",
      "query": "Dự báo tháng tới tôi có nguy cơ vỡ quỹ không?",
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "budget_forecast_alert", "args": {"month": "next_month"}}]},
      "metadata": {"skill": "route_bonus_forecast", "difficulty": "hard", "what_it_tests": "Bonus tool - dự báo và cảnh báo vỡ quỹ."}
    },
    {
      "id": "G05_advice_5030", "phase": "B", "suite": "group",
      "query": "Quy tắc 50/30/20 là gì và tôi nên áp dụng thế nào?",
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "search_financial_advice", "args": {"topic": "50/30/20"}}]},
      "metadata": {"skill": "route_advice_5030", "difficulty": "medium", "what_it_tests": "Tra cứu quy tắc tài chính phải dùng search_financial_advice."}
    },
    {
      "id": "GM01_record_with_clarify_note", "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Ghi chi tiêu 320000 đồng ăn lẩu tối nay."},
        {"role": "user", "content": "Ghi chú ăn với bạn bè."},
        {"role": "user", "content": "Xác nhận và lưu lại."}
      ],
      "failure_type": "missing_info",
      "expect": {"tool_calls": [{"name": "record_transaction", "args": {"type": "expense", "category": "food", "amount": 320000, "note": "ăn với bạn bè", "confirmed": true}}]},
      "metadata": {"skill": "multiturn_fill_note", "difficulty": "hard", "what_it_tests": "Carry amount rồi điền note và confirmed từ các lượt sau."}
    },
    {
      "id": "GM02_correct_period", "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Tổng chi tiêu tuần này là bao nhiêu?"},
        {"role": "user", "content": "À không, tuần trước mới đúng."},
        {"role": "user", "content": "Cho tôi xem với khoảng thời gian đã sửa."}
      ],
      "failure_type": "wrong_arg_value",
      "expect": {"tool_calls": [{"name": "get_summary", "args": {"period": "last_week"}}]},
      "metadata": {"skill": "multiturn_period_correction", "difficulty": "hard", "what_it_tests": "Period được sửa ở lượt sau phải được áp dụng."}
    },
    {
      "id": "GM03_advice_then_breakdown", "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Quỹ khẩn cấp là gì?"},
        {"role": "user", "content": "Chi tiêu của tôi tháng này thế nào?"},
        {"role": "user", "content": "Cho tôi xem cả hai thông tin."}
      ],
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [
        {"name": "search_financial_advice", "args": {"topic": "quỹ khẩn cấp"}},
        {"name": "get_summary", "args": {"period": "this_month"}}
      ]},
      "metadata": {"skill": "multiturn_advice_summary", "difficulty": "hard", "what_it_tests": "Gọi song song advice và summary tools."}
    },
    {
      "id": "GM04_compare_two_periods", "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Chi tiêu ăn uống tuần này là bao nhiêu?"},
        {"role": "user", "content": "Còn tuần trước thì sao?"},
        {"role": "user", "content": "So sánh hai tuần."}
      ],
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [
        {"name": "get_category_breakdown", "args": {"period": "this_week", "category": "food"}},
        {"name": "get_category_breakdown", "args": {"period": "last_week", "category": "food"}}
      ]},
      "metadata": {"skill": "multiturn_period_comparison", "difficulty": "hard", "what_it_tests": "Carry category và gọi hai breakdown với period khác nhau."}
    },
    {
      "id": "GM05_record_confirm", "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Ghi chi tiêu 90000 đồng xăng xe hôm nay."},
        {"role": "user", "content": "Tôi xác nhận muốn lưu."},
        {"role": "user", "content": "Thực hiện ghi ngay."}
      ],
      "failure_type": "wrong_boundary",
      "expect": {"tool_calls": [{"name": "record_transaction", "args": {"type": "expense", "category": "transport", "amount": 90000, "note": "xăng xe", "confirmed": true}}]},
      "metadata": {"skill": "multiturn_record_confirm", "difficulty": "hard", "what_it_tests": "Sau khi xác nhận mới gọi record_transaction với confirmed=true."}
    }
  ]
}
